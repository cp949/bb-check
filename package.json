{
  "name": "bb-check-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run --exclude \"scripts/**\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "lint": "eslint tests --no-error-on-unmatched-pattern && turbo run lint",
    "format:check": "prettier --check .",
    "check-package-files": "node scripts/check-package-files.mjs",
    "test-packed-package": "node scripts/test-packed-package.mjs",
    "check-public-words": "node scripts/check-public-words.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run check-package-files && npm run test-packed-package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "rollup": "4.62.5",
    "rollup-plugin-dts": "6.5.1",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
