{
  "name": "@cp949/legacy-browser-smoke",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "legacy-browser-smoke-self-test": "./bin/legacy-browser-smoke-self-test.mjs"
  },
  "files": [
    "bin/**",
    "dist/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && rollup -c rollup.dts.config.mjs",
    "prepack": "node ../../scripts/copy-root-license.mjs",
    "prepublishOnly": "node ../../scripts/publish-package.mjs --lifecycle-guard && npm --prefix ../.. run verify:package-release",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "lint": "eslint . --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0"
  }
}
